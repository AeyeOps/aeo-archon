# Claude Code OpenTelemetry Configuration for OpenObserve
# Source this file in your shell profile or Claude Code hooks
#
# Usage: Add to ~/.bashrc or ~/.zshrc:
#   source /opt/aeo/aeo-archon/scripts/claude-code-otel.env
#
# Or use with Claude Code hooks (see docs)

# =============================================================================
# REQUIRED: Enable Claude Code Telemetry
# =============================================================================
CLAUDE_CODE_ENABLE_TELEMETRY=1

# =============================================================================
# OpenObserve OTLP Endpoint Configuration
# =============================================================================
# OpenObserve uses port 5080 with /api/{org} path (not standard 4317/4318)
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default

# Basic Auth: admin@archon.local:archon123 = YWRtaW5AYXJjaG9uLmxvY2FsOmFyY2hvbjEyMw==
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic YWRtaW5AYXJjaG9uLmxvY2FsOmFyY2hvbjEyMw==

# =============================================================================
# Signal Exporters
# =============================================================================
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# =============================================================================
# Export Intervals (milliseconds)
# =============================================================================
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_LOGS_EXPORT_INTERVAL=5000

# =============================================================================
# Metrics Cardinality Control
# =============================================================================
OTEL_METRICS_INCLUDE_SESSION_ID=true
OTEL_METRICS_INCLUDE_VERSION=true
OTEL_METRICS_INCLUDE_ACCOUNT_UUID=true

# =============================================================================
# Resource Attributes (for filtering in OpenObserve)
# =============================================================================
OTEL_RESOURCE_ATTRIBUTES=service.name=claude-code,deployment.environment=development,team.id=aeo

# =============================================================================
# Optional Privacy Settings (uncomment to enable)
# =============================================================================
# Log full user prompts (default: redacted for privacy)
# OTEL_LOG_USER_PROMPTS=1

# Disable Anthropic telemetry (Statsig, Sentry) - only send to OpenObserve
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
