        {
          "id": "Panel_ServiceLatency",
          "type": "bar",
          "title": "Latency by Service (p95)",
          "description": "95th percentile latency per service",
          "config": {
            "show_legends": true
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT service_name, APPROX_PERCENTILE_CONT(duration / 1000000, 0.95) as p95_ms FROM \"default\" WHERE _timestamp >= NOW() - INTERVAL '1 HOUR' GROUP BY service_name ORDER BY p95_ms DESC LIMIT 10",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
                  {
                    "label": "Service",
                    "alias": "service_name",
                    "column": "service_name"
                  }
                ],
                "y": [
                  {
                    "label": "P95 Latency (ms)",
                    "alias": "p95_ms",
                    "column": "duration"
                  }
                ],
                "z": [],
                "filter": []
              },
              "config": {}
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 8,
            "i": 1
