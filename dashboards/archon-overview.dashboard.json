      "panels": [
        {
          "id": "Panel_TotalTraces",
          "type": "metric",
          "title": "Total Traces (24h)",
          "description": "Total number of traces in the last 24 hours",
          "config": {
            "show_legends": false,
            "unit": ""
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT count(*) as value FROM \"default\" WHERE _timestamp >= NOW() - INTERVAL '24 HOURS'",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [],
                "y": [
                  {
                    "label": "Total",
                    "alias": "value",
                    "column": "*",
                    "aggregationFunction": "count"
                  }
                ],
                "z": [],
                "filter": []
              },
              "config": {}
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 3,
            "h": 4,
            "i": 1
          }
        },
        {
          "id": "Panel_ErrorRate",
          "type": "metric",
          "title": "Error Rate",
          "description": "Percentage of traces with errors",
          "config": {
            "show_legends": false,
            "unit": "%"
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT ROUND(100.0 * COUNT(CASE WHEN status_code = 2 THEN 1 END) / NULLIF(COUNT(*), 0), 2) as value FROM \"default\" WHERE _timestamp >= NOW() - INTERVAL '24 HOURS'",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [],
                "y": [],
                "z": [],
                "filter": []
              },
              "config": {}
            }
