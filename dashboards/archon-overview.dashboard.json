          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT ROUND(AVG(duration) / 1000000, 2) as value FROM \"default\" WHERE _timestamp >= NOW() - INTERVAL '1 HOUR'",
              "customQuery": true,
              "fields": {
