{
  "dashboardId": "archon_overview",
  "title": "Archon Stack Overview",
  "description": "Observability dashboard for Archon services and Claude Code telemetry",
  "version": 5,
  "owner": "admin@archon.local",
  "created": "2025-12-27T00:00:00Z",
  "updatedAt": "2025-12-27T00:00:00Z",
  "role": "viewer",
  "defaultDatetimeDuration": "1h",
  "tabs": [
    {
      "tabId": "overview_tab",
      "name": "Overview",
      "panels": [
        {
          "id": "trace_count",
          "type": "line",
          "title": "Traces Over Time",
          "description": "Number of traces per minute",
          "layout": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 5
          },
          "queries": [
            {
              "query": "SELECT date_bin(interval '1 minute', _timestamp) as 'Time', count(*) as 'Count' FROM \"archon_server\" GROUP BY date_bin(interval '1 minute', _timestamp) ORDER BY 'Time'",
              "type": "sql",
              "fields": {}
            }
          ],
          "queryType": "sql",
          "config": {
            "type": "line",
            "legend": {
              "enabled": true,
              "position": "bottom"
            },
            "colors": ["#5470c6"]
          }
        },
        {
          "id": "service_breakdown",
          "type": "pie",
          "title": "Traces by Service",
          "description": "Distribution of traces across services",
          "layout": {
            "x": 0,
            "y": 5,
            "width": 6,
            "height": 5
          },
          "queries": [
            {
              "query": "SELECT service_name as 'Service', count(*) as 'Count' FROM \"archon_server\" GROUP BY service_name ORDER BY 'Count' DESC LIMIT 10",
              "type": "sql",
              "fields": {}
            }
          ],
          "queryType": "sql",
          "config": {
            "type": "pie",
            "legend": {
              "enabled": true,
              "position": "right"
            }
          }
        },
        {
          "id": "avg_latency",
          "type": "line",
          "title": "Average Latency (ms)",
          "description": "Average span duration over time",
          "layout": {
            "x": 6,
            "y": 5,
            "width": 6,
            "height": 5
          },
          "queries": [
            {
              "query": "SELECT date_bin(interval '1 minute', _timestamp) as 'Time', AVG(duration) / 1000000 as 'Avg Latency (ms)' FROM \"archon_server\" GROUP BY date_bin(interval '1 minute', _timestamp) ORDER BY 'Time'",
              "type": "sql",
              "fields": {}
            }
          ],
          "queryType": "sql",
          "config": {
            "type": "line",
            "legend": {
              "enabled": true
            },
            "colors": ["#91cc75"]
          }
        },
        {
          "id": "top_spans",
          "type": "table",
          "title": "Top Span Names",
          "description": "Most frequent operations",
          "layout": {
            "x": 0,
            "y": 10,
            "width": 12,
            "height": 5
          },
          "queries": [
            {
              "query": "SELECT span_name as 'Operation', count(*) as 'Count', ROUND(AVG(duration) / 1000000, 2) as 'Avg ms' FROM \"archon_server\" GROUP BY span_name ORDER BY 'Count' DESC LIMIT 15",
              "type": "sql",
              "fields": {}
            }
          ],
          "queryType": "sql",
          "config": {
            "type": "table"
          }
        }
      ]
    },
    {
      "tabId": "errors_tab",
      "name": "Errors",
      "panels": [
        {
          "id": "error_traces",
          "type": "line",
          "title": "Error Traces Over Time",
          "description": "Traces with error status",
          "layout": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 5
          },
          "queries": [
            {
              "query": "SELECT date_bin(interval '1 minute', _timestamp) as 'Time', count(*) as 'Errors' FROM \"archon_server\" WHERE status_code = 2 GROUP BY date_bin(interval '1 minute', _timestamp) ORDER BY 'Time'",
              "type": "sql",
              "fields": {}
            }
          ],
          "queryType": "sql",
          "config": {
            "type": "line",
            "legend": {
              "enabled": true
            },
            "colors": ["#ee6666"]
          }
        },
        {
          "id": "error_by_service",
          "type": "bar",
          "title": "Errors by Service",
          "description": "Error distribution across services",
          "layout": {
            "x": 0,
            "y": 5,
            "width": 6,
            "height": 5
          },
          "queries": [
            {
              "query": "SELECT service_name as 'Service', count(*) as 'Errors' FROM \"archon_server\" WHERE status_code = 2 GROUP BY service_name ORDER BY 'Errors' DESC",
              "type": "sql",
              "fields": {}
            }
          ],
          "queryType": "sql",
          "config": {
            "type": "bar",
            "legend": {
              "enabled": true
            },
            "colors": ["#ee6666"]
          }
        },
        {
          "id": "error_by_span",
          "type": "bar",
          "title": "Errors by Operation",
          "description": "Which operations are failing",
          "layout": {
            "x": 6,
            "y": 5,
            "width": 6,
            "height": 5
          },
          "queries": [
            {
              "query": "SELECT span_name as 'Operation', count(*) as 'Errors' FROM \"archon_server\" WHERE status_code = 2 GROUP BY span_name ORDER BY 'Errors' DESC LIMIT 10",
              "type": "sql",
              "fields": {}
            }
          ],
          "queryType": "sql",
          "config": {
            "type": "bar",
            "legend": {
              "enabled": true
            },
            "colors": ["#fc8452"]
          }
        }
      ]
    },
    {
      "tabId": "latency_tab",
      "name": "Latency",
      "panels": [
        {
          "id": "latency_distribution",
          "type": "line",
          "title": "Latency Distribution Over Time",
          "description": "p50, p95, p99 latency",
          "layout": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 6
          },
          "queries": [
            {
              "query": "SELECT date_bin(interval '1 minute', _timestamp) as 'Time', AVG(duration) / 1000000 as 'avg_ms', MAX(duration) / 1000000 as 'max_ms' FROM \"archon_server\" GROUP BY date_bin(interval '1 minute', _timestamp) ORDER BY 'Time'",
              "type": "sql",
              "fields": {}
            }
          ],
          "queryType": "sql",
          "config": {
            "type": "line",
            "legend": {
              "enabled": true
            }
          }
        },
        {
          "id": "slowest_spans",
          "type": "table",
          "title": "Slowest Operations",
          "description": "Operations with highest average latency",
          "layout": {
            "x": 0,
            "y": 6,
            "width": 12,
            "height": 5
          },
          "queries": [
            {
              "query": "SELECT span_name as 'Operation', count(*) as 'Count', ROUND(AVG(duration) / 1000000, 2) as 'Avg ms', ROUND(MAX(duration) / 1000000, 2) as 'Max ms' FROM \"archon_server\" GROUP BY span_name ORDER BY 'Avg ms' DESC LIMIT 15",
              "type": "sql",
              "fields": {}
            }
          ],
          "queryType": "sql",
          "config": {
            "type": "table"
          }
        }
      ]
    }
  ],
  "variables": []
}
